# Vaani Shopping Assistant - Environment Variables Configuration Example
# Copy this file to .env for local deployment. NEVER commit real secrets or API keys.

# Optional: Hugging Face Free Inference API Token for cloud zero-shot classification / embeddings
# Get a free token at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_your_free_token_here
HF_TOKEN=hf_your_free_token_here

# Optional: OpenAI Whisper Model Size ("tiny", "base", "small")
WHISPER_MODEL_SIZE=base

# Optional: Server Hosting Settings
HOST=0.0.0.0
PORT=8000
